{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "sessionlayer-controlplane values",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "global": { "type": "object" },
    "replicaCount": { "type": "integer", "minimum": 1 },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": "string" },
        "digest": {
          "type": "string",
          "pattern": "^$|^sha256:[a-f0-9]{64}$",
          "description": "Empty, or a full sha256 image digest."
        },
        "pullPolicy": { "enum": ["Always", "IfNotPresent", "Never"] }
      }
    },
    "imagePullSecrets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name"],
        "properties": { "name": { "type": "string", "minLength": 1 } }
      }
    },
    "nameOverride": { "type": "string", "maxLength": 63 },
    "fullnameOverride": { "type": "string", "maxLength": 63 },
    "serviceAccount": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "create": { "type": "boolean" },
        "name": { "type": "string" },
        "annotations": { "type": "object" },
        "automountServiceAccountToken": { "type": "boolean" }
      }
    },
    "secrets": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "existingSecret": {
          "type": "string",
          "description": "Name of a Secret carrying every Control Plane credential. Required at render time; this chart never creates one."
        }
      }
    },
    "database": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "r2dbcUrl": { "type": "string", "pattern": "^r2dbc:postgresql://" },
        "r2dbcUsername": { "type": "string", "minLength": 1 },
        "flywayUrl": { "type": "string", "pattern": "^jdbc:postgresql://" },
        "flywayUsername": { "type": "string", "minLength": 1 }
      }
    },
    "mtls": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "extraHostnames": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    },
    "recording": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "worm": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "endpoint": { "type": "string", "pattern": "^$|^https?://" },
            "region": { "type": "string", "minLength": 1 },
            "bucket": { "type": "string", "minLength": 1 },
            "pathStyleAccess": { "type": "boolean" }
          }
        }
      }
    },
    "oidc": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "issuer": { "type": "string", "pattern": "^$|^https://" },
        "clientId": { "type": "string" },
        "redirectUri": { "type": "string", "pattern": "^$|^https://" }
      }
    },
    "java": {
      "type": "object",
      "additionalProperties": false,
      "properties": { "toolOptions": { "type": "string" } }
    },
    "sessionLimits": {
      "type": "object",
      "additionalProperties": false,
      "properties": { "defaultMaxConcurrent": { "type": "string", "pattern": "^$|^[1-9][0-9]*$" } }
    },
    "bootstrap": {
      "type": "object",
      "additionalProperties": false,
      "properties": { "adminSubject": { "type": "string" } }
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": { "enum": ["ClusterIP", "NodePort", "LoadBalancer"] },
        "name": { "type": "string", "minLength": 1, "maxLength": 63 },
        "annotations": { "type": "object" },
        "ports": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "rest": { "type": "integer", "minimum": 1, "maximum": 65535 },
            "mtlsGrpc": { "type": "integer", "minimum": 1, "maximum": 65535 }
          }
        }
      }
    },
    "resources": { "type": "object" },
    "podSecurityContext": { "type": "object" },
    "containerSecurityContext": { "type": "object" },
    "probes": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "readiness": { "$ref": "#/definitions/probe" },
        "liveness": { "$ref": "#/definitions/probe" },
        "startup": { "$ref": "#/definitions/probe" }
      }
    },
    "terminationGracePeriodSeconds": { "type": "integer", "minimum": 0 },
    "updateStrategy": { "type": "object" },
    "tmpVolume": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "medium": { "enum": ["", "Memory"] },
        "sizeLimit": { "type": "string", "minLength": 1 }
      }
    },
    "podDisruptionBudget": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "minAvailable": { "type": ["integer", "string"] }
      }
    },
    "networkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "gatewayPodSelector": { "type": "object" },
        "agentPodSelector": { "type": "object" },
        "dnsPodSelector": { "type": "object" },
        "postgresPodSelector": { "type": "object" },
        "otelPodSelector": { "type": "object" },
        "wormCidrs": { "$ref": "#/definitions/cidrList" },
        "oidcCidrs": { "$ref": "#/definitions/cidrList" },
        "extraGrpcIngressCidrs": { "$ref": "#/definitions/cidrList" },
        "extraIngress": { "type": "array", "items": { "type": "object" } },
        "extraEgress": { "type": "array", "items": { "type": "object" } }
      }
    },
    "podAnnotations": { "type": "object" },
    "podLabels": { "type": "object" },
    "nodeSelector": { "type": "object" },
    "tolerations": { "type": "array", "items": { "type": "object" } },
    "affinity": { "type": "object" },
    "topologySpreadConstraints": { "type": "array", "items": { "type": "object" } },
    "priorityClassName": { "type": "string" },
    "extraEnv": { "type": "array", "items": { "type": "object" } },
    "extraEnvFrom": { "type": "array", "items": { "type": "object" } },
    "extraVolumes": { "type": "array", "items": { "type": "object" } },
    "extraVolumeMounts": { "type": "array", "items": { "type": "object" } }
  },
  "definitions": {
    "probe": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "periodSeconds": { "type": "integer", "minimum": 1 },
        "timeoutSeconds": { "type": "integer", "minimum": 1 },
        "failureThreshold": { "type": "integer", "minimum": 1 }
      }
    },
    "cidrList": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^([0-9]{1,3}\\.){3}[0-9]{1,3}/[0-9]{1,2}$|^[0-9a-fA-F:]+/[0-9]{1,3}$"
      }
    }
  }
}
