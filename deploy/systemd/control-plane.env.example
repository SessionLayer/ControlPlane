# Copy to /etc/sessionlayer/control-plane.env, root-owned, mode 0600 - it
# carries real secrets below.

SPRING_R2DBC_URL=r2dbc:postgresql://db.example.com:5432/sessionlayer
SPRING_R2DBC_USERNAME=cp_runtime
SPRING_FLYWAY_URL=jdbc:postgresql://db.example.com:5432/sessionlayer
SPRING_FLYWAY_USER=sessionlayer

SESSIONLAYER_MTLS_SERVER_PORT=9443
SESSIONLAYER_MTLS_SERVER_HOSTNAMES=cp.example.com,localhost

SESSIONLAYER_RECORDING_WORM_ENDPOINT=https://worm.example.com
SESSIONLAYER_RECORDING_WORM_REGION=us-east-1
SESSIONLAYER_RECORDING_WORM_BUCKET=sessionlayer-recordings
SESSIONLAYER_RECORDING_WORM_PATH_STYLE_ACCESS=false

SESSIONLAYER_OIDC_ENABLED=true
SESSIONLAYER_OIDC_ISSUER=https://idp.example.com
SESSIONLAYER_OIDC_CLIENT_ID=sessionlayer-controlplane
SESSIONLAYER_OIDC_REDIRECT_URI=https://cp.example.com/v1/auth/callback

JAVA_TOOL_OPTIONS=-XX:MaxRAMPercentage=75.0

SPRING_FLYWAY_PASSWORD=REPLACE-ME-owner-password
# Substituted into the cp_runtime role's ALTER ROLE on the FIRST migration
# only (V11). Must equal SPRING_R2DBC_PASSWORD, alphanumeric only. Rotating
# later means ALTER ROLE cp_runtime PASSWORD ... in Postgres directly, in
# lockstep with SPRING_R2DBC_PASSWORD - changing this afterwards rotates
# nothing. This is a Map key (spring.flyway.placeholders.cpRuntimePassword);
# verified empirically that this exact env var name binds it correctly on
# Spring Boot 4.1.0, despite Spring's general caveat about env-derived Map
# keys being lower-cased.
SPRING_FLYWAY_PLACEHOLDERS_CPRUNTIMEPASSWORD=REPLACE-ME-runtime-password
SPRING_R2DBC_PASSWORD=REPLACE-ME-runtime-password

# 32-byte base64 key-encryption-key for the local CA backend. No dev-KEK
# fallback here on purpose: an operator who forgets this fails closed at boot
# rather than silently wrapping CA keys under a public constant.
SESSIONLAYER_CA_LOCAL_KEK_BASE64=REPLACE-ME-32-byte-base64-kek

SESSIONLAYER_OIDC_CLIENT_SECRET=REPLACE-ME-oidc-client-secret
SESSIONLAYER_OIDC_STATE_HMAC_KEY=REPLACE-ME-oidc-state-hmac-key

SESSIONLAYER_RECORDING_WORM_ACCESS_KEY=REPLACE-ME-worm-access-key
SESSIONLAYER_RECORDING_WORM_SECRET_KEY=REPLACE-ME-worm-secret-key
